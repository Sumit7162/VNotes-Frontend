# Google Authentication
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API URL.
# Local development uses the value below. In production this is the Cloud Run
# service URL, set as an environment variable in Vercel rather than committed
# here. (It used to point at a Hugging Face Space; that Space was deleted.)
#
# Nothing else is needed for email sign-in: the signup, login, verification and
# password-reset calls all go through this same base URL.
VITE_API_URL=http://localhost:8000
