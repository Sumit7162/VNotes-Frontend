# Google Authentication
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API URL.
# Local development uses the value below; in production this is the Hugging
# Face Space that hosts the backend, https://sumit67-vnotes.hf.space, set as an
# environment variable in Vercel rather than committed here.
VITE_API_URL=http://localhost:8000
